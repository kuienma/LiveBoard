# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，不会进仓库。
# 密钥只存在后端环境变量，前端永不直连大模型（docs/spec.md 第 7 节）。

# ── 识别用的大模型 ────────────────────────────────────────────────
# 协议：anthropic（Messages API）或 openai（Chat Completions，兼容各类网关）
AI_PROVIDER=anthropic

# 模型 id。填你的网关实际支持的名字（本项目用的是 Qwen3.8-Max）
AI_MODEL=Qwen3.8-Max

# 接口地址。指向本地网关或官方地址；留空则用官方默认
AI_BASE_URL=http://127.0.0.1:38080

# 凭据。留空时会依次回退到 ANTHROPIC_AUTH_TOKEN / ANTHROPIC_API_KEY / OPENAI_API_KEY
AI_API_KEY=

# 凭据放在哪个请求头：bearer（Authorization: Bearer）或 x-api-key
# anthropic 协议下留空会自动判断：AI_API_KEY 走 bearer，ANTHROPIC_API_KEY 走 x-api-key
AI_AUTH_STYLE=

# 单次识别的输出上限
AI_MAX_OUTPUT_TOKENS=16000

# 思考档位：只有 Claude 模型支持，转发其它模型的网关会报错或忽略。
# 非 Claude 模型请留空。
AI_EFFORT=

# 网关不支持结构化输出（output_config / response_format）时置为 1，
# 改为在提示词里要求只输出 JSON，再由后端自己抽取。
# 留 0 也安全：首次请求报「不认识该参数」会自动退化并记住。
# 用 scripts/probe.ts 可以先探明到底支持不支持。
AI_DISABLE_STRUCTURED_OUTPUT=0

# ── 服务端 ───────────────────────────────────────────────────────
PORT=8787
# 训练库 SQLite 文件位置。相对路径是相对「启动服务时的工作目录」，
# pnpm dev:api 的 cwd 是 apps/server，所以默认会落在 apps/server/data/。
# 启动日志里会打印解析后的绝对路径。
DB_PATH=data/drills.db
# 识别接口限频（每 IP 每小时次数），防止 API 费用失控
RECOGNIZE_RATE_LIMIT_PER_HOUR=20

# 导出视频存放目录，文件保留 1 小时
EXPORT_DIR=data/exports
# 同时渲染几个导出任务。1080p 逐帧是纯 CPU 活，并发只会互相拖慢
EXPORT_CONCURRENCY=1
# ffmpeg 可执行文件路径，留空走 PATH
FFMPEG_PATH=

# 前端产物目录。设了就由后端一起托管（生产模式，单端口同源）。
# 本地开发别设：那时前端走 Vite，由它代理 /api。
# Docker 里由 compose 固定为 /app/apps/web/dist。
WEB_DIST=

# ── 导出配音（语音合成）─────────────────────────────────────────
# volcano（火山引擎大模型语音合成）/ mac-say（本机自测，仅 macOS）/ 留空不配音
TTS_PROVIDER=

# 端点。可以给完整地址，也可以只给主机根地址（会自动补 SSE 路径）
VOLCANO_TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
# chunked / sse；留空按端点末尾自动判断
VOLCANO_TTS_TRANSPORT=

# 新版控制台只需要 API Key
VOLCANO_TTS_API_KEY=
# 旧版控制台用这两个（与上面的 API Key 二选一）
VOLCANO_TTS_APP_ID=
VOLCANO_TTS_ACCESS_KEY=

# 决定模型版本与计费方式。注意没有 cluster 参数（那是老接口）
VOLCANO_TTS_RESOURCE_ID=seed-tts-2.0

# 音色 ID，不是控制台里的展示名。
# 例：展示名「Vivi 2.0」对应 zh_female_vv_uranus_bigtts，
# 填展示名会报 resource ID is mismatched with speaker related resource。
# 音色必须和 VOLCANO_TTS_RESOURCE_ID 的模型版本匹配（2.0 的音色只能配 seed-tts-2.0）。
TTS_VOICE=

# 合成结果缓存目录。按内容哈希命中，同一训练反复导出不重复计费
TTS_CACHE_DIR=data/tts-cache
